flowchart LR
    Start((Старт: рекомендованная цена готова))

    subgraph L1["Дорожка: Бизнес-эксперт"]
        T1["Проверить обоснование цены"]
        G1{"Обоснование достаточно?"}
        T2["Согласовать цену"]
        T3["Вернуть на доработку"]
    end

    subgraph L2["Дорожка: Коммерческий руководитель"]
        T4["Проверить влияние на маржу и продажи"]
        G2{"Коммерческий риск приемлем?"}
        T5["Утвердить публикацию"]
    end

    subgraph L3["Дорожка: Система публикации цен"]
        DS1[("Реестр утверждённых цен")]
        SP1[["Подпроцесс: публикация цены в целевых каналах"]]
        T6["Зафиксировать дату публикации"]
        T7["Сформировать отчёт о публикации"]
    end

    End((Конец: цена опубликована))
    Rework((Конец: цена возвращена на доработку))

    Start --> T1 --> G1
    G1 -- Да --> T4 --> G2
    G1 -- Нет --> T3 --> Rework
    G2 -- Да --> T2 --> T5 --> DS1 --> SP1 --> T6 --> T7 --> End
    G2 -- Нет --> T3
